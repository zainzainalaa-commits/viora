{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Harbor",
        "decorations": true,
        "transparent": false,
        "backgroundColor": [0, 0, 0, 255],
        "additionalBrowserArgs": ""
      }
    ]
  },
  "bundle": {
    "externalBin": [],
    "fileAssociations": [],
    "createUpdaterArtifacts": false,
    "resources": {
      "fonts/*": "fonts/"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        { "host": "harbor.site", "pathPrefix": ["/open"] }
      ],
      "desktop": {
        "schemes": ["harbor", "stremio"]
      }
    }
  }
}
